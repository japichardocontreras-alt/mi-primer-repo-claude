# ============================================================
#  MUDANZAS METEPEC | ERP — Variables de entorno
#  Copie este archivo a .env y reemplace los valores.
#  NUNCA suba el archivo .env al repositorio.
# ============================================================

# Conexión a PostgreSQL (producción: usuario con permisos solo sobre esta BD)
DATABASE_URL="postgresql://USUARIO:CONTRASENA@HOST:5432/erp?schema=public"

# Base de datos EXCLUSIVA para pruebas automatizadas (se borra en cada corrida).
# Nunca apunte a la base de datos real.
TEST_DATABASE_URL="postgresql://USUARIO:CONTRASENA@HOST:5432/erp_test?schema=public"

# Duración de la sesión en horas (por defecto 12)
SESSION_TTL_HOURS=12

# Carpeta privada para archivos adjuntos (fotos y documentos). En producción use una ruta
# absoluta fuera del código y respáldela, p. ej. /var/lib/erp/archivos
STORAGE_DIR="./storage"

# Puerto e interfaz del servidor (npm start). Detrás de Caddy/Nginx use HOSTNAME=127.0.0.1
# PORT=3000
# HOSTNAME=127.0.0.1

# Administrador inicial (solo se usa al ejecutar `npm run db:seed` si no existe ningún usuario).
# Detalle de todas las variables: docs/VARIABLES.md
# Se le pedirá cambiar la contraseña en el primer inicio de sesión.
SEED_ADMIN_EMAIL="admin@mudanzasmetepec.com"
SEED_ADMIN_NAME="Administrador"
SEED_ADMIN_PASSWORD="cambie-esta-contrasena-temporal"

# Base AISLADA para el recorrido en navegador (npm run e2e:reset). Nombre con «e2e».
# E2E_DATABASE_URL="postgresql://USUARIO:CONTRASENA@HOST:5432/erp_e2e?schema=public"

# Ruta a pg_dump para la descarga de respaldos desde Configuración (opcional)
PG_DUMP_PATH="pg_dump"
